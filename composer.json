{
    "name": "stromcom/customer-sdk",
    "description": "Official PHP SDK for the STROMCOM Customer API (/api/customer/v1).",
    "type": "library",
    "license": "MIT",
    "keywords": ["stromcom", "sdk", "api", "customer", "messaging", "threads"],
    "homepage": "https://stromcom.cz",
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.94"
    },
    "scripts": {
        "test:unit": "phpunit",
        "phpstan": "vendor/bin/phpstan analyse -c phpstan.dist.neon",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "test": [
            "@test:unit"
        ],
        "ca": [
            "@phpstan",
            "@cs"
        ]
    },
    "autoload": {
        "psr-4": {
            "Stromcom\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Stromcom\\Sdk\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Petr Bíža",
            "email": "petr.biza@stromcom.cz"
        }
    ],
    "support": {
        "issues": "https://github.com/stromcom/php-customer-sdk/issues",
        "source": "https://github.com/stromcom/php-customer-sdk"
    },
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true
    }
}
